# Peak Load Demand Monitoring - Environment Configuration
# Copy this file to .env and fill in your actual values
# WARNING: .env is git-ignored for security. Never commit real credentials!

# =============================================================================
# System Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# System mode: "live" (use PEA scraper) or "simulation" (use simulated data)
SYSTEM_MODE=live

# Cache duration in seconds (default: 300 = 5 minutes)
CACHE_DURATION_SECONDS=300

# =============================================================================
# PEA AMR Credentials - Plant 1 (Main Factory)
# =============================================================================
PEA_PLANT1_USERNAME=0200xxxxxxxxxx
PEA_PLANT1_PASSWORD=your_password_here
PEA_PLANT1_NAME=Factory 1 (Main)
PEA_PLANT1_TYPE=TOU
PEA_PLANT1_CONTROL_LINE=2000.0

# =============================================================================
# PEA AMR Credentials - Plant 2 (Extension Factory)
# =============================================================================
PEA_PLANT2_USERNAME=0200xxxxxxxxxx
PEA_PLANT2_PASSWORD=your_password_here
PEA_PLANT2_NAME=Factory 2 (Ext)
PEA_PLANT2_TYPE=TOU
PEA_PLANT2_CONTROL_LINE=1500.0

# =============================================================================
# PEA AMR Credentials - Plant 3 (Auxiliary Factory)
# =============================================================================
PEA_PLANT3_USERNAME=0200xxxxxxxxxx
PEA_PLANT3_PASSWORD=your_password_here
PEA_PLANT3_NAME=Factory 3 (Aux)
PEA_PLANT3_TYPE=TOU
PEA_PLANT3_CONTROL_LINE=800.0

# =============================================================================
# PEA AMR Credentials - Plant 4 (Old Factory)
# =============================================================================
PEA_PLANT4_USERNAME=0200xxxxxxxxxx
PEA_PLANT4_PASSWORD=your_password_here
PEA_PLANT4_NAME=Factory 4 (Old)
PEA_PLANT4_TYPE=TOD
PEA_PLANT4_CONTROL_LINE=1200.0

# =============================================================================
# Scraper Configuration
# =============================================================================
SCRAPE_INTERVAL_MINUTES=15
MAX_LOGIN_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=15

# =============================================================================
# Line Notify (Optional - for alerts)
# =============================================================================
LINE_NOTIFY_TOKEN=your_line_token_here
